{
    "name": "krpano-cutter-tools",
    "version": "1.0.2",
    "description": "纯浏览器 krpano 切图工具，支持全景 cube 与高清矩阵 flat 的 multires 瓦片",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node ./node_modules/typescript/bin/tsc",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build",
        "release": "release-it"
    },
    "author": "yejunweb",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yejunweb/krpano-cutter-tools.git"
    },
    "bugs": {
        "url": "https://github.com/yejunweb/krpano-cutter-tools/issues"
    },
    "homepage": "https://github.com/yejunweb/krpano-cutter-tools#readme",
    "engines": {
        "node": ">=14"
    },
    "keywords": [
        "krpano",
        "panorama",
        "cube",
        "flat",
        "multires",
        "tile",
        "webgl"
    ],
    "license": "MIT",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^12.0.2",
        "release-it": "^21.1.0",
        "typescript": "5.8.3"
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release v${version}",
            "tagName": "v${version}",
            "pushRepo": "origin_github"
        },
        "github": {
            "release": true,
            "releaseName": "v${version}"
        },
        "npm": {
            "publish": true
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "preset": {
                    "name": "angular"
                },
                "infile": "CHANGELOG.md"
            }
        }
    }
}
